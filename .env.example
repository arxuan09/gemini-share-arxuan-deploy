# ============================================================
# gemini-share-arxuan 部署配置
#
# 复制一份再改：cp .env.example .env
# 一键部署脚本 ./install.sh 会自动生成 .env 并引导填写，不用手动复制。
# docker-compose.yml 不需要改，所有配置都在这个文件里。
#
# 审计接口（你的用户中心）不在这里配置：部署后到管理台「设置 → 审计接口」填写，保存立即生效。
# ============================================================

# 授权码（我给你的那串）。必填。
LICENSE_KEY=

# 管理台 /admin/ 的登录密码（也是管理接口的 token）。
# 不填 = 用授权码登录；填了 = 只能用这个密码登录，授权码不再能进后台。
ADMIN_PASSWORD=

# 宿主机对外端口。访问地址是 http://服务器IP:这个端口/
GATEWAY_PORT=19081

# ---------- MySQL ----------
# 默认用本部署自带的 MySQL 容器，一般不用改。要用外部 MySQL（并且不启动自带实例），
# 见 README「使用外部 MySQL / Redis」。
# 注意：用自带 MySQL 时，MYSQL_PASSWORD / MYSQL_DATABASE 只在第一次初始化（data/mysql 为空）时生效，
# 数据库建好后再改会导致网关连不上库；自带 MySQL 只支持 root 账号。密码不要包含 @ / : 等特殊字符。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=gemini123
MYSQL_DATABASE=gemini

# ---------- Redis ----------
# 默认用本部署自带的 Redis 容器。要用外部 Redis，见 README「使用外部 MySQL / Redis」。
# REDIS_DB 是 Redis 的库编号（0-15）。同一个 Redis 上放着几套互不相关的网关时用不同编号隔开；
# 多实例的几台服务器是同一个网关，必须用同一个编号。
# 用自带 Redis 时，填了 REDIS_PASSWORD 会自动开启密码认证。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 多实例（多台服务器分担流量，一主多副）----------
# 只有一台服务器就不用改。多台服务器一起跑同一个网关时，所有服务器连同一套 MySQL / Redis
# （上面的 MySQL / Redis 配置、REDIS_DB 都要完全一样），见 README「进阶二：多实例」。
# 注意：一套网关给多个站点（多个用户中心）用是另一个功能，不在这里配，见 README「进阶一：多用户中心」。
# NODE_ROLE：primary（主实例，只能有一台）或 replica（副实例）。
# NODE_ID：节点名，可以不填。不填时主实例叫 main，副实例自动生成一个（如 node-3fa9c1），
# 保存在 data/gemini-share-arxuan/node_id，重启 / 升级都不变。想要好认的名字（如 hk-1）就填上，每台必须不同。
NODE_ROLE=primary
NODE_ID=
